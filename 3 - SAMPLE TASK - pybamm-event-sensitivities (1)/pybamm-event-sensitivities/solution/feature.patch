diff --git a/src/pybamm/solvers/event_sensitivity.py b/src/pybamm/solvers/event_sensitivity.py
new file mode 100644
index 0000000..c2e677d
--- /dev/null
+++ b/src/pybamm/solvers/event_sensitivity.py
@@ -0,0 +1,143 @@
+"""Event-aligned derivatives for autonomous IDAKLU experiment steps.
+
+The integrator evolves derivatives at fixed absolute time. At a moving
+boundary these are converted to total endpoint derivatives for state transfer,
+then converted back for the next vector field.
+"""
+
+import casadi
+import numpy as np
+from scipy.sparse.linalg import spsolve
+
+import pybamm
+
+
+def _packed(inputs):
+    return np.concatenate([np.asarray(v).reshape(-1) for v in inputs.values()])
+
+
+def flow(model, t, y, inputs):
+    """Full state time derivative, including index-one algebraic variables."""
+    y = np.asarray(y).reshape(-1)
+    packed = _packed(inputs)
+    rhs = np.asarray(model.rhs_eval(t, y, packed)).reshape(-1)
+    if not model.is_standard_form_dae:
+        rhs = model.mass_matrix_inv.entries @ rhs
+    if not model.len_alg:
+        return rhs
+    jac = model.jac_algebraic_eval(t, y, packed).sparse().tocsr()
+    # Supported experiment dynamics are autonomous within each step.
+    algebraic_dot = spsolve(jac[:, model.len_rhs:], -jac[:, :model.len_rhs] @ rhs)
+    return np.concatenate([rhs, np.asarray(algebraic_dot).reshape(-1)])
+
+
+def total_history(history):
+    """Make an isolated last-state view with total endpoint derivatives."""
+    if isinstance(history, pybamm.EmptySolution):
+        return history, {}
+    times = getattr(history, '_all_time_sensitivities', {})
+    if not times:
+        raise pybamm.SolverError('Continuation requires event-sensitive history')
+    state = history.last_state.copy()
+    model = state.all_models[-1]
+    tau = {k: np.asarray(v[-1])[-1].copy() for k, v in times.items()}
+    velocity = flow(model, state.t[-1], state.y[:, -1], state.all_inputs[-1])
+    state._all_sensitivities = {
+        k: [np.asarray(v[-1]) + velocity[:, None] * tau[k][None, :]]
+        for k, v in state._all_sensitivities.items()
+    }
+    return state, tau
+
+
+def seed_fixed_time(solver, model, t, inputs, tau):
+    """Convert transferred total derivatives to fixed-time initial values."""
+    if not tau:
+        return
+    velocity = flow(model, t, model.y0, inputs)
+    names = model.calculate_sensitivities
+    model.y0S = tuple(
+        np.asarray(s).reshape(-1) - velocity * float(tau[name][0])
+        for name, s in zip(names, model.y0S, strict=True)
+    )
+    solver._set_consistent_initialization(model, t, inputs)
+
+
+def _event_time(solution, model, inputs):
+    name = solution.termination.removeprefix('event: ')
+    event = next(e for e in model.events if e.name == name)
+    t = casadi.MX.sym('t')
+    y = casadi.MX.sym('y', model.len_rhs_and_alg)
+    symbols = {k: casadi.MX.sym(k, np.asarray(v).size) for k, v in inputs.items()}
+    p = casadi.vertcat(*symbols.values())
+    g = event.expression.to_casadi(t, y, inputs=symbols)
+    fun = casadi.Function('event_derivatives', [t, y, p],
+                          [casadi.jacobian(g, y), casadi.jacobian(g, p), casadi.jacobian(g, t)])
+    gy, gp, gt = fun(solution.t[-1], solution.y[:, -1], _packed(inputs))
+    velocity = flow(model, solution.t[-1], solution.y[:, -1], inputs)
+    denominator = float(gy @ velocity + gt)
+    if not np.isfinite(denominator) or abs(denominator) < 1e-12:
+        raise pybamm.SolverError('Event sensitivity requires a transverse event')
+    n = model.len_rhs_and_alg
+    fixed = np.asarray(solution._all_sensitivities['all'][-1])[-n:]
+    columns = []
+    offset = 0
+    for key, value in inputs.items():
+        if key in model.calculate_sensitivities:
+            columns.extend(range(offset, offset + np.asarray(value).size))
+        offset += np.asarray(value).size
+    return -np.asarray(gy @ fixed + gp[:, columns]).reshape(-1) / denominator
+
+
+def finish(solution, model, inputs, tau):
+    """Record derivatives of phase-aligned sample times and the actual endpoint."""
+    names = model.calculate_sensitivities
+    initial = np.array([float(tau.get(k, [0])[0]) for k in names])
+    endpoint = _event_time(solution, model, inputs) if solution.termination.startswith('event: ') else initial
+    blocks = [np.broadcast_to(initial, (len(t), len(names))).copy() for t in solution.all_ts]
+    blocks[-1][-1] = endpoint
+    solution._all_time_sensitivities = {'all': blocks}
+    for column, name in enumerate(names):
+        solution._all_time_sensitivities[name] = [b[:, column:column + 1].copy() for b in blocks]
+
+
+def variable_phase_sensitivities(variable):
+    """Total output derivatives at fixed step-relative times (and endpoints)."""
+    fixed = variable.sensitivities
+    times = variable.all_time_sensitivities
+    if not times:
+        raise pybamm.SolverError('Event sensitivities were not calculated')
+    corrections = []
+    for ts, ys, inputs, expression, model, dt in zip(
+        variable.all_ts, variable.all_ys, variable.all_inputs,
+        variable.base_variables, variable.all_models, times['all'], strict=True
+    ):
+        t = casadi.MX.sym('t'); y = casadi.MX.sym('y', ys.shape[0])
+        symbols = {k: casadi.MX.sym(k, np.asarray(v).size) for k, v in inputs.items()}
+        p = casadi.vertcat(*symbols.values())
+        expr = expression.to_casadi(t, y, inputs=symbols)
+        if not model.len_alg:
+            velocity = model.rhs_eval(t, y, p)
+            if not model.is_standard_form_dae:
+                velocity = casadi.DM(model.mass_matrix_inv.entries) @ velocity
+            rate_function = casadi.Function('output_rate', [t, y, p],
+                [casadi.jacobian(expr, y) @ velocity + casadi.jacobian(expr, t)])
+            rates = np.asarray(rate_function.map(len(ts))(ts, ys, _packed(inputs)))
+            corrections.extend(rates[:, i, None] * dt[i][None, :] for i in range(len(ts)))
+            continue
+        derivative = casadi.Function('output_time_derivative', [t, y, p],
+            [casadi.jacobian(expr, y), casadi.jacobian(expr, t)])
+        packed = _packed(inputs)
+        for i, time in enumerate(ts):
+            dy, direct = derivative(time, ys[:, i], packed)
+            velocity = flow(model, time, ys[:, i], inputs)
+            rate = np.asarray(dy @ velocity + direct).reshape(-1)
+            corrections.append(rate[:, None] * dt[i][None, :])
+    all_values = np.asarray(fixed['all']) + np.vstack(corrections)
+    result = {'all': all_values}
+    offset = 0
+    for name in times:
+        if name != 'all':
+            width = times[name][0].shape[1]
+            result[name] = all_values[:, offset:offset + width]
+            offset += width
+    return result
